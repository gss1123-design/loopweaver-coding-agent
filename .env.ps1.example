# Copy to .env.ps1 and fill in the credentials for the provider you use.
$env:ANTHROPIC_API_KEY = "your_anthropic_api_key"
$env:OPENAI_API_KEY = "your_openai_api_key"
$env:DEEPSEEK_API_KEY = "your_deepseek_api_key"

# Optional Feishu integration.
$env:FEISHU_APP_ID = "your_feishu_app_id"
$env:FEISHU_APP_SECRET = "your_feishu_app_secret"
$env:FEISHU_VERIFY_TOKEN = ""

$env:LOOPWEAVER_PROVIDER = "anthropic"
$env:LOOPWEAVER_MODEL_ID = "claude-sonnet-4-5"
